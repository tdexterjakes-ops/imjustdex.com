---
import '../styles/sermon-notes.css';
import prefaces from '../data/sermons/prefaces.json';
import delivery from '../data/sermons/delivery.json';
interface Props { study: { body: string; contents: string; copyright: string }; }
const { study } = Astro.props;
// Paragraph-length callouts use reading type; preserve the imported words and markup.
const readingBody = study.body.replace(/<p class="landing">([\s\S]*?)<\/p>/g, (markup, content: string) => {
  const words = content.replace(/<[^>]*>/g, '').trim().split(/\s+/).length;
  return words >= 20 ? markup.replace('class="landing"', 'class="landing landing-reading"') : markup;
});
const slug = Astro.url.pathname.replace(/\/+$/, '').split('/').pop() ?? '';
// What was preached and what stayed in the notes, sub-point by sub-point. Same
// reason as the preface for living outside study.body: the importer regenerates
// that body and asserts byte-equality, so a tag written into it would be lost.
// Marked against the recording; Dexter is the authority on all 27.
const DELIVERY_LABEL: Record<string, { sr: string; text: string }> = {
  full: { sr: 'Preached ', text: 'in full' },
  part: { sr: 'Preached ', text: 'in part' },
  page: { sr: 'Kept ', text: 'on the page' },
};
const entry = (delivery as Record<string, { legend: string; points: Record<string, string> }>)[slug];
const deliveryPoints: Record<string, string> = entry?.points ?? {};
// Those keys are sub-point ids from study.body, which import-sermon-study.py
// regenerates — reword a heading upstream and its id changes. A silent miss
// would render a legend keying marks that are no longer there, so fail loudly,
// the way the importer already asserts its 43 open passages.
const bodyHeadingIds = new Set([...study.body.matchAll(/<h3\b[^>]*\bid="([^"]+)"/g)].map(m => m[1]));
const orphanedPoints = Object.keys(deliveryPoints).filter(id => !bodyHeadingIds.has(id));
if (orphanedPoints.length) {
  throw new Error(`delivery.json lists sub-points absent from "${slug}": ${orphanedPoints.join(', ')}`);
}
// Contents ships the 8 movements. The 27 sub-points already carry ids in the
// body, so the outline is read back off those headings rather than duplicated
// into the study data — a regenerated JSON cannot fall out of step with it.
const subPoints = new Map<string, { id: string; label: string }[]>();
const headings = /<(h2|h3)\b[^>]*\bid="([^"]+)"[^>]*>([\s\S]*?)<\/\1>/g;
let heading: RegExpExecArray | null;
let movement: string | null = null;
while ((heading = headings.exec(study.body)) !== null) {
  const [, tag, id, inner] = heading;
  if (tag === 'h2') { movement = id; subPoints.set(id, []); continue; }
  // Scripture-reference ids and anything outside a movement are not outline rows.
  if (movement) subPoints.get(movement)!.push({ id, label: inner.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim() });
}
const contentsOutline = study.contents.replace(/<li><a href="#([^"]+)"[\s\S]*?<\/a><\/li>/g, (row, id: string) => {
  const points = subPoints.get(id) ?? [];
  if (!points.length) return row;
  const items = points.map(point => {
    const state = deliveryPoints[point.id];
    const copy = state ? DELIVERY_LABEL[state] : undefined;
    // The mark sits at the row's end, clear of the current-row edge and the indent.
    const mark = copy
      ? `<span class="sr-only">${copy.sr.toLowerCase()}${copy.text}</span>` +
        `<span class="sub-mark" data-state="${state}" aria-hidden="true"></span>`
      : '';
    return `<li><a href="#${point.id}"><span data-label>${point.label}</span>${mark}</a></li>`;
  }).join('');
  return row.replace('</li>', `<ul class="sub-nav">${items}</ul></li>`);
});
// The preacher's note stands between the orientation paragraphs and the first
// movement. It is composed here rather than written into study.body: that body
// is regenerated from the canonical Sermons package by import-sermon-study.py,
// which asserts byte-equality in --check mode, so prose typed into it would
// both fail that check and be overwritten on the next import.
const prefaceLines: string[] = (prefaces as Record<string, string[]>)[slug] ?? [];
// Appended inside the h3 so heading navigation announces the state with the
// heading. The gap is a margin rather than a literal space, so the separator
// cannot collapse; the accessible name still reads "<heading> preached in
// full" because name computation joins child nodes with a space. The h3 is a
// block, not a flex container — the whitespace-stripping that forced the same
// choice on .notes-button does not apply here.
const taggedBody = readingBody.replace(/(<h3\b[^>]*\bid="([^"]+)"[^>]*>)([\s\S]*?)(<\/h3>)/g,
  (markup: string, open: string, id: string, label: string, close: string) => {
    const state = deliveryPoints[id];
    const copy = state ? DELIVERY_LABEL[state] : undefined;
    if (!copy) return markup;
    return `${open}${label}<span class="delivery-tag" data-state="${state}">` +
      `<span class="sr-only">${copy.sr}</span>${copy.text}</span>${close}`;
  });
const firstMovement = taggedBody.search(/<h2[\s>]/);
const intro = firstMovement < 0 ? taggedBody : taggedBody.slice(0, firstMovement);
const movements = firstMovement < 0 ? '' : taggedBody.slice(firstMovement);
---
<div class="sermon-study">
  <span id="read" aria-hidden="true"></span>
  <details class="mobile-contents" id="contents">
    <summary><span>Contents · <span data-mobile-label>God has not left you</span></span><svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m5 7 5 5 5-5" /></svg></summary>
    <nav aria-label="Study contents" set:html={contentsOutline} />
    {/* Folding belongs with the outline: on a 57-screen study the only control
        the reader can always reach is the one welded to the sticky bar. */}
    <div class="contents-tools" hidden>
      <button class="notes-button" type="button" data-fold-passages hidden>Fold passages</button>
    </div>
  </details>
  <div class="reading-tools">
    <button class="notes-button" type="button" data-resume hidden><span>Resume · <span data-resume-label></span></span></button>
    <a class="notes-button" href="#the-study-underneath">Begin study</a>
    <button class="notes-button" type="button" data-print hidden>Print notes</button>
  </div>
  {/* The attribution also stands here, at the top of the body. The footer notice
      is ~100 screens down a 60-minute study, so a reader who finishes and closes
      the tab never reaches it. Same imported sentence, not a second wording. */}
  <div class="notes-credit" set:html={study.copyright} />
  <Fragment set:html={intro} />
  {prefaceLines.length > 0 && (
    <aside class="study-preface">
      {prefaceLines.map((line) => <p>{line}</p>)}
    </aside>
  )}
  {/* The key to the marks, next to the note that explains why they exist. The
      three read as peers: none of them is the page apologising for itself. */}
  {entry && (
    <aside class="delivery-legend" aria-label="How the sub-points are marked">
      <ul>
        {(['full', 'part', 'page'] as const).map((state) => (
          <li><span class="sub-mark" data-state={state} aria-hidden="true"></span>{DELIVERY_LABEL[state].text}</li>
        ))}
      </ul>
      <p>{entry.legend}</p>
    </aside>
  )}
  <Fragment set:html={movements} />
  <footer class="notes-footer" set:html={study.copyright} />
</div>
<script>
  import '../scripts/sermon-notes.js';
</script>
