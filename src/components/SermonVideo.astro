---
/**
 * Click-to-play facade for a sermon's broadcast video.
 *
 * Why a facade instead of a bare <iframe>: the sermon-notes page makes no
 * third-party requests at all. A YouTube iframe costs roughly a megabyte of
 * Google script plus cookies on every page load, charged to every reader —
 * including the ones who only came to read. This renders a local WebP still
 * and contacts youtube-nocookie.com only once a reader asks for playback.
 *
 * Why the trigger is an <a> and not a <button>: with JavaScript unavailable
 * the link still reaches the sermon. The bundled script upgrades it to
 * in-page playback. The page is never a dead end.
 *
 * The embed requires `frame-src https://www.youtube-nocookie.com` in the
 * netlify.toml CSP. The policy is self-only otherwise, and without that
 * directive the player blanks with no visible error.
 */
interface Props {
  videoId: string;
  title: string;
  channel: string;
  dateLabel?: string;
  poster: string;
  posterNarrow?: string;
  posterVersion?: string;
  duration?: string;
  heading?: string;
}

const {
  videoId,
  title,
  channel,
  dateLabel,
  poster,
  posterNarrow,
  posterVersion,
  duration,
  heading = 'Watch the sermon',
} = Astro.props;

// /img/* ships under `Cache-Control: max-age=31536000, immutable` and the
// poster path carries no content hash, so replacing its bytes in place strands
// every reader who already holds the old plate — for a year. The article OG
// plates solve this with ?v=<ogImagePhase>; posters use the same convention.
// Bump posterVersion in videos.json whenever the image is re-rendered.
const v = posterVersion ? `?v=${posterVersion}` : '';

const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
// nocookie host: no cross-site cookie before playback.
// rel=0: no end-screen recommendations pulling readers off the study.
const embedSrc = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
const posterSrc = `${poster}${v}`;
const posterSrcset = posterNarrow ? `${posterNarrow}${v} 800w, ${posterSrc} 1200w` : undefined;
const spokenName = `Play “${title}” — ${channel}${dateLabel ? `, ${dateLabel}` : ''}`;
---
<section class="sermon-video" aria-labelledby="sermon-video-heading">
  <h2 class="sermon-video-heading" id="sermon-video-heading">{heading}</h2>

  <div
    class="sermon-video-stage"
    data-sermon-video
    data-embed={embedSrc}
    data-embed-title={`${title} — ${channel}`}
  >
    <a
      class="sermon-video-trigger"
      href={watchUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-sermon-video-trigger
    >
      <img
        class="sermon-video-poster"
        src={posterSrc}
        srcset={posterSrcset}
        sizes="(max-width: 760px) 100vw, 728px"
        width="1200"
        height="675"
        alt=""
        {/* The stage sits directly under the article header, inside the first
            viewport on phone and desktop alike, so it is the page's likely LCP
            element. Lazy-loading it would deprioritize exactly the wrong image. */}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      {/* Chip and track read as one control bar. Stacked, the knob sat
          directly under the chip and looked like a fragment of it. */}
      <span class="sermon-video-bar" aria-hidden="true">
        <span class="sermon-video-play">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8 5l12 7-12 7z" fill="currentColor" />
          </svg>
          <span>Play</span>
        </span>
        <span class="sermon-video-track"></span>
      </span>
      <span class="sr-only">{spokenName}</span>

    </a>
  </div>

  <!-- Title, venue and date are all in the article header already, and the
       poster art carries the channel's own branding — repeating any of it here
       is noise. What a reader does not otherwise know is that pressing play
       hands them to a third party, so that is what this line says. -->
  <!-- The link is always present, never revealed by detection. An iframe fires
       `load` even when the browser renders its own network-error page inside
       it, so a timer cleared on load is dead code for exactly the failures it
       exists to catch - a blocked frame, a filtered network, a privacy
       extension. A route out that is always there cannot mis-detect. -->
  <p class="sermon-video-chrome">
    <span class="sermon-video-meta">Plays from <a href={watchUrl} target="_blank" rel="noopener noreferrer">YouTube</a>{duration ? ` · ${duration}` : ''}</span>
    <button class="sermon-video-dismiss" type="button" data-sermon-video-dismiss hidden>Close player</button>
  </p>

  <p class="sermon-video-print">Watch: {watchUrl}</p>
</section>

<script>
  import '../scripts/sermon-video.js';
</script>

<style>
  /* Chrome register and spacing come from the sermon-notes system
     (DESIGN-SYSTEM.md §15), not from local values: the notes were moved onto
     --body/--mono/--display tokens, and --notes-muted/--notes-red no longer
     exist. The PLAY block follows the .notes-button recipe, recoloured to the
     accent because it sits on imagery rather than on --panel. */
  /* The chrome band under the stage is bounded by the stage's rule above and
     the Contents bar's rule below, so this bottom margin is not separation
     between blocks - it is dead space inside a framed strip. Matched to the
     band above the stage instead. */
  .sermon-video {
    /* Padding, not a margin on the heading: .article-body has no top border or
       padding (padding-top:0 is deliberate, so the Contents bar can weld to the
       header frame), so a top margin here collapses straight out of the body
       and the label stays crowded against the rule above it. */
    padding-top: var(--space-xs);
    margin: 0 0 var(--space-xs);
  }

  /* Even above and below the glyph, not the line box: uppercase mono leaves
     ~1.5px of half-leading above the caps and ~2.1px below the baseline, so
     equal margins still read top-crowded. 8/8 lands the caps on the band's
     optical centre and keeps the band the same height it was at 0/16. */
  .sermon-video-heading {
    margin: 0 0 var(--space-xs);
    font-family: var(--mono);
    font-size: var(--text-label);
    font-weight: var(--weight-bold);
    line-height: var(--lh-snug);
    letter-spacing: var(--track-chrome);
    text-transform: uppercase;
    color: var(--body-muted);
  }

  /* Full-bleed inside the frame, the same way .landing and the Contents bar do it. */
  /* Collapsed until asked for: at 16/9 the block pushed the wayfinding layer
     down a surface people come to READ. The crop is anchored to the bottom of
     the plate (object-position below), which drops the plate's own masthead -
     the lockup it was duplicating from the page header 200px above - while
     keeping the hero line whole and preserving the plate's bottom margin, so
     the PLAY chip still lands on empty ground instead of over the type.
     2.1/1 is the tightest ratio that does all three. Expanding on click is a
     user-initiated shift, not CLS. */
  .sermon-video-stage {
    position: relative;
    aspect-ratio: var(--sermon-video-ratio, 2.1 / 1);
    margin-inline: calc(-1 * var(--space-lg));
    border-block: var(--border-weight-content) solid var(--border);
    /* Deliberately not a theme token: this is video letterbox, not a themed
       surface. --ink inverts to cream in dark mode and framed the player in a
       pale slab. Black is correct in both modes. */
    background: #000;
    overflow: hidden;
  }

  .sermon-video-trigger {
    position: absolute;
    inset: 0;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .sermon-video-poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  /* One control bar across the stage's foot: chip, then the track running to
     the far edge. A play chip alone reads as a badge on a still; the timeline
     is what says "timed medium" at a glance. */
  .sermon-video-bar {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: flex;
    align-items: stretch;
  }

  .sermon-video-track {
    position: relative;
    flex: 1;
    align-self: center;
    height: var(--sermon-video-track, 4px);
    background: rgba(245, 245, 241, .32);
  }

  /* No knob and no fill. At zero a knob marks nothing, and a red square set
     immediately beside the red chip reads as a fragment breaking off it
     rather than a control - it was misread twice in review. The track, the
     chip and the runtime carry the video grammar without it. */

  .sermon-video-play {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-height: 44px;
    padding: var(--space-sm) var(--space-chrome);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--mono);
    font-size: var(--text-label);
    font-weight: var(--weight-bold);
    line-height: var(--lh-snug);
    letter-spacing: var(--track-chrome);
    text-transform: uppercase;
    transition: background var(--motion-fast) var(--ease-default);
  }

  .sermon-video-play svg {
    width: 1em;
    height: 1em;
    flex: none;
  }

  .sermon-video-trigger:hover .sermon-video-play,
  .sermon-video-trigger:focus-visible .sermon-video-play {
    background: var(--ink);
    color: var(--bg);
  }

  /* Drawn INSIDE the trigger. The stage clips overflow, and the trigger fills
     it edge to edge, so a positive offset put the ring outside the clip and it
     never painted. Negative offset is the system's own answer for full-bleed
     controls (sermon-notes.css: summary and .movement-nav a both use -2px). */
  .sermon-video-trigger:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: -3px;
  }

  .sermon-video-stage[data-state='playing'] {
    --sermon-video-ratio: 16 / 9;
  }

  .sermon-video-stage[data-state='playing'] .sermon-video-track {
    display: none;
  }

  .sermon-video-stage[data-state='playing'] .sermon-video-trigger[hidden] {
    display: none;
  }

  .sermon-video-meta a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .sermon-video-meta a:hover {
    color: var(--accent-text);
  }

  .sermon-video-meta a:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: 2px;
  }

  .sermon-video-chrome {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin: var(--space-xs) 0 0;
  }

  .sermon-video-dismiss {
    appearance: none;
    min-height: 44px;
    padding: var(--space-sm) var(--space-chrome);
    border: var(--border-weight-chrome) solid var(--border);
    border-radius: 0;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--mono);
    font-size: var(--text-label);
    font-weight: var(--weight-bold);
    line-height: var(--lh-snug);
    letter-spacing: var(--track-chrome);
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--ease-default);
  }

  .sermon-video-dismiss:hover {
    border-color: var(--accent);
  }

  .sermon-video-dismiss:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: 2px;
  }

  .sermon-video-dismiss[hidden] {
    display: none;
  }

  .sermon-video-meta {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--text-label);
    line-height: var(--lh-snug);
    letter-spacing: var(--track-chrome);
    text-transform: uppercase;
    color: var(--body-muted);
  }

  .sermon-video-print {
    display: none;
  }

  @media (max-width: 760px) {
    .sermon-video-stage {
      margin-inline: calc(-1 * var(--space-md));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sermon-video-play {
      transition: none;
    }
  }

  /* The notes are built to be printed; a dead black rectangle is not. */
  @media print {
    .sermon-video-stage {
      display: none;
    }

    .sermon-video-print {
      display: block;
      margin: var(--space-xs) 0 0;
      font-family: var(--mono);
      font-size: var(--text-label);
      line-height: var(--lh-snug);
    }
  }
</style>

<!-- The player iframe is created by script after the reader presses play, so
     Astro never stamps it with this component's scope attribute and a scoped
     rule silently fails to match — the frame collapses to the browser default
     300x150. Namespaced under the stage class to keep the global leak nil. -->
<style is:global>
  .sermon-video-stage > .sermon-video-embed {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
